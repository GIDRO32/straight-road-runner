  moveset:
  - moveName: Run
    input: A / D or Left / Right
    description: Run along the road.
    icon: {fileID: 0}
  - moveName: Jump
    input: Space, W or Up
    description: Jump. Keeps Super Run speed when jumping while super running.
    icon: {fileID: 0}
  - moveName: Super Run
    input: Hold Left Shift
    description: Run much faster on the ground. Drains stamina.
    icon: {fileID: 0}
  - moveName: Punch
    input: Z
    description: Punch enemies, walls and signs in front of you.
    icon: {fileID: 0}
  - moveName: Uppercut
    input: X
    description: Upward strike.
    icon: {fileID: 0}
  - moveName: Super Jump
    input: Hold S / Down to charge, then C
    description: Charge while ducking, then launch high into the air. Costs 30 stamina.
    icon: {fileID: 0}
  - moveName: Air Dash
    input: Double-tap A / D in the air
    description: Quick dash in the air. Costs 5 stamina.
    icon: {fileID: 0}
